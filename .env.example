# Phantom Console Environment Variables

# Set to 'true' to enable Séance Mode (mock data, no AWS required)
DEMO_MODE=true

# Server port (default: 3000)
PORT=3000

# AWS credentials are read from ~/.aws/credentials or environment
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
